-- Função para atacar
local function attackEnemy(aggressive)
    local character = LocalPlayer.Character
    if not character then return end
    
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid then return end
    
    -- Equipar melhor arma
    local weapons = {}
    for _, tool in pairs(character:GetChildren()) do
        if tool:IsA("Tool") then
            table.insert(weapons, tool)
        end
    end
    
    if #weapons > 0 then
        humanoid:EquipTool(weapons[1])
    end
    
    -- Ataque básico
    VirtualInputManager:SendKeyEvent(true, "Z", false, game)
    wait(0.05)
    VirtualInputManager:SendKeyEvent(false, "Z", false, game)
    
    -- Se agressivo ou autoSkills
    if aggressive or autoSkills then
        wait(0.08)
        VirtualInputManager:SendKeyEvent(true, "X", false, game)
        wait(0.05)
        VirtualInputManager:SendKeyEvent(false, "X", false, game)
        wait(0.08)
        VirtualInputManager:SendKeyEvent(true, "C", false, game)
        wait(0.05)
        VirtualInputManager:SendKeyEvent(false, "C", false, game)
        wait(0.08)
        VirtualInputManager:SendKeyEvent(true, "V", false, game)
        wait(0.05)
        VirtualInputManager:SendKeyEvent(false, "V", false, game)
    end
end

-- Função para encontrar inimigo mais próximo
local function findNearestEnemy(distance, filterBoss)
    local character = LocalPlayer.Character
    if not character then return nil end
    
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return nil end
    
    local nearestEnemy = nil
    local nearestDistance = distance or 100
    
    local enemiesFolder = workspace:FindFirstChild("Enemies")
    if not enemiesFolder then return nil end
    
    for _, enemy in pairs(enemiesFolder:GetChildren()) do
        if enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then
            local enemyRoot = enemy:FindFirstChild("HumanoidRootPart")
            if enemyRoot then
                local isBoss = enemy.Name:lower():find("boss") or enemy.Name:lower():find("raid") or enemy.Name:lower():find("elite")
                if filterBoss == nil or (filterBoss == true and isBoss) or (filterBoss == false and not isBoss) then
                    local dist = (enemyRoot.Position - humanoidRootPart.Position).Magnitude
                    if dist < nearestDistance then
                        nearestDistance = dist
                        nearestEnemy = enemy
                    end
                end
            end
        end
    end
    
    return nearestEnemy
end

-- Função para teleportar
local function teleportTo(position)
    local character = LocalPlayer.Character
    if not character then return end
    
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if humanoidRootPart then
        humanoidRootPart.CFrame = CFrame.new(position)
    end
end

-- Função para coletar materiais (drops)
local function collectMaterials()
    local character = LocalPlayer.Character
    if not character then return end
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return end
    
    local items = {}
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Part") or obj:IsA("MeshPart") then
            local name = obj.Name:lower()
            if name:find("item") or name:find("drop") or name:find("chest") or name:find("material") or name:find("fruit") or name:find("gem") or name:find("coin") then
                if obj:FindFirstChild("Position") then
                    table.insert(items, obj)
                end
            end
        end
    end
    
    local nearestItem = nil
    local nearestDist = 50
    for _, item in pairs(items) do
        local dist = (item.Position - humanoidRootPart.Position).Magnitude
        if dist < nearestDist then
            nearestDist = dist
            nearestItem = item
        end
    end
    
    if nearestItem then
        teleportTo(nearestItem.Position)
        wait(0.5)
    end
end

